[Unit]
Description=Kwartje quarterly restore test (restores the latest backup into a temp folder)
After=kwartje-backup.service
OnFailure=kwartje-notify@%n.service

[Service]
Type=oneshot
User=kwartje
Group=kwartje
ExecStart=/usr/local/bin/kwartje --config /etc/kwartje/config.toml restore-test --latest
ExecStartPost=/usr/local/lib/kwartje/notify.sh success kwartje-restore-test
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/var/backups/kwartje /etc/kwartje
