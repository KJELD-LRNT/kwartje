# /etc/kwartje/restic.env  (mode 0640, owner root:kwartje)
# Offsite repository, e.g. Backblaze B2, an S3 bucket, or rest-server on another host.
RESTIC_REPOSITORY="s3:https://s3.example.com/kwartje-backup"
RESTIC_PASSWORD_FILE="/etc/kwartje/restic-password"
# Backend credentials (S3/B2 example):
AWS_ACCESS_KEY_ID="CHANGE-ME"
AWS_SECRET_ACCESS_KEY="CHANGE-ME"
