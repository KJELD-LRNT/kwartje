# /etc/kwartje/notify.env  (mode 0600, owner root)
# ntfy topic for failures (self-hosted or ntfy.sh with a long random topic name):
NTFY_URL="https://ntfy.example.nl/kwartje-CHANGE-ME"
# Optional access token for a protected ntfy topic:
#NTFY_TOKEN="tk_..."
# Optional Uptime Kuma push monitors (type "Push", heartbeat interval ~25h):
#KUMA_PUSH_BACKUP="https://kuma.example.nl/api/push/XXXXXXXX?status=up&msg=OK"
#KUMA_PUSH_RESTIC="https://kuma.example.nl/api/push/YYYYYYYY?status=up&msg=OK"
#KUMA_PUSH_RESTORE_TEST="https://kuma.example.nl/api/push/ZZZZZZZZ?status=up&msg=OK"
